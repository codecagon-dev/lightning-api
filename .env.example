# Direct Node development: cp .env.example .env, then fill the key below.
# Docker production: cp .env.example .env.production, set NODE_ENV=production
# and FRONTEND_ORIGIN=https://app.example.com (exact origin, no trailing slash).
# Compose enforces production, localhost binding and /app/data database location.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/lightning.sqlite
FRONTEND_ORIGIN=http://localhost:5173
# Required: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Store separately from database; recovery requires both database and original key.
CREDENTIAL_ENCRYPTION_KEY=
